{
  // Live-tjenesten for kurssiden. Deploy og oppsett: docs/oppsett.md.
  // account_id er Lars sin private gratiskonto. Står den her, kan ikke en
  // wrangler-innlogging mot en annen konto deploye hit ved en feil.
  "name": "claude-kurs",
  "main": "index.js",
  "account_id": "4518e8ea4e898abb13fe02f5383c33b8",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Kommaseparert. localhost og 127.0.0.1 er alltid lov, for lokal utvikling.
    "ALLOWED_ORIGINS": "https://larsekhansen.github.io"
  },
  "observability": { "enabled": true }
  // PRESENTER_TOKEN er en secret: npx wrangler secret put PRESENTER_TOKEN
}
